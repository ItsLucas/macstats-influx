        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"MacMini\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"temperature\")\n  |> filter(fn: (r) => r[\"_field\"] == \"celsius\")\n  |> filter(fn: (r) => r[\"host\"] == \"Lucas-Mac\")\n  |> filter(fn: (r) => r[\"sensor\"] =~ /CPU Performance Core.*/ or r[\"sensor\"] =~ /CPU Efficiency Core.*/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")",
          "refId": "A"
        }
      ],
      "title": "CPU Core Temperatures",
      "type": "timeseries"
